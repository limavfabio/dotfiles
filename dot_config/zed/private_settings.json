// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_buffer_font_size": 13.0,
  "agent_ui_font_size": 16.0,
  "buffer_font_weight": 400.0,
  "buffer_font_family": "JetBrains Mono",
  "terminal": {
    "font_weight": 300.0,
    "font_family": ".ZedMono"
  },
  "icon_theme": "Colored Zed Icons Theme Light",
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "play_sound_when_agent_done": "when_hidden",
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
    "sandbox_permissions": {
      "allow_unsandboxed": true
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark"
  },
  "languages": {
    "Elixir": {
      "language_servers": ["expert", "!elixir-ls", "!dexter", "!next-ls", "!lexical", "..."]
    },
    "EEx": {
      "language_servers": ["expert", "!elixir-ls", "!dexter", "!next-ls", "!lexical", "..."]
    },
    "HEEx": {
      "language_servers": ["expert", "!elixir-ls", "!dexter", "!next-ls", "!lexical", "..."]
    }
  },
  "auto_install_extensions": {
    "html": true,
    "dockerfile": true,
    "docker-compose": true,
    "ruby": true,
    "emmet": true,
    "ruff": true,
    "golangci-lint": true,
    "colored-zed-icons-theme": true,
    "templ": true,
    "mermaid": true,
    "toml": true,
    "git-firefly": true,
    "make": true,
    "rainbow-csv": true,
    "sql": true
  }
}
